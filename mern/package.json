{
  "name": "microlearn-mern",
  "version": "1.0.0",
  "description": "MicroLearn MERN edition: Express (MVC) + MongoDB/Mongoose + JWT auth, with a React + Tailwind client",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seeds/seed.js",
    "test": "jest --runInBand",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "build": "npm run client:install && npm run client:build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  },
  "jest": { "testEnvironment": "node", "testTimeout": 30000 }
}
