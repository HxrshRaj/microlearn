# Copy this file to .env and adjust as needed.

# Postgres connection string used by Knex (server/db/knex.js) and the migration CLI.
# Matches the service defined in docker-compose.yml out of the box.
DATABASE_URL=postgres://microlearn:microlearn@localhost:5432/microlearn

# Port the Express server listens on.
PORT=3000

# Secret used to hash session cookie values (HMAC). Change this in production —
# rotating it invalidates every existing session.
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Set to "production" to enable secure-cookie enforcement (requires HTTPS).
NODE_ENV=development
